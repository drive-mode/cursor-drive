# Copy to .env in repo root.

# GitHub MCP (.cursor/mcp.json). Create PAT at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=
# GPAT=  # alternative (wrapper script uses this)

# Cloudflare (for .github/workflows/cloudflare-token-test.yml)
# Add as Repository secrets: Settings → Secrets and variables → Actions → Repository secrets
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Legacy auth (for local verify when API token fails): Global API Key + account email
# GLOBAL_API_KEY=
# CLOUDFLARE_ACCOUNT_EMAIL=

# Local verify: API_FIXER or CLOUDFLARE_API_TOKEN (API token), or GLOBAL_API_KEY+CLOUDFLARE_ACCOUNT_EMAIL (legacy)
# API_FIXER=

# Optional - only for Terraform legacy auth or Origin CA operations (not used by token test):
# GLOBAL_API_KEY=
# ORIGIN_CA_KEY=

# For scripts/trigger-cloudflare-test.mjs (trigger workflow via API)
# GITHUB_REPO=drive-mode/cursor-drive  # default for ai-secretagent token
