{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "pythonw .cursor/hooks/drive-preprocessor.py beforeSubmitPrompt"
      },
      {
        "command": "pythonw .cursor/hooks/plan-runner.py beforeSubmitPrompt"
      }
    ],
    "sessionStart": [
      {
        "command": "pythonw .cursor/hooks/plan-save-to-workspace.py"
      },
      {
        "command": "pythonw .cursor/hooks/plan-runner.py sessionStart"
      }
    ],
    "stop": [
      {
        "command": "pythonw .cursor/hooks/plan-runner.py stop"
      }
    ],
    "subagentStop": [
      {
        "command": "pythonw .cursor/hooks/plan-runner.py subagentStop"
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/pre-tool-use.js"
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/post-tool-use.js"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/after-file-edit.js"
      }
    ]
  }
}